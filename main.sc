                "тридцать первое":31,"тридцать первого":31,"тридцать первый":31,"31":31
            };

            function parseMonthStr(ms) {
                ms = ms.toLowerCase();
                if      (ms.indexOf("январ")   !== -1) return 1;
                else if (ms.indexOf("феврал")  !== -1) return 2;
                else if (ms.indexOf("март")    !== -1) return 3;
                else if (ms.indexOf("апрел")   !== -1) return 4;
                else if (ms.indexOf("ма")      !== -1) return 5;
                else if (ms.indexOf("июн")     !== -1) return 6;
                else if (ms.indexOf("июл")     !== -1) return 7;
                else if (ms.indexOf("август")  !== -1) return 8;
                else if (ms.indexOf("сентябр") !== -1) return 9;
                else if (ms.indexOf("октябр")  !== -1) return 10;
                else if (ms.indexOf("ноябр")   !== -1) return 11;
                else if (ms.indexOf("декабр")  !== -1) return 12;
                return null;
            }

            var fromDay = null, fromMonth = null, fromYear = new Date().getFullYear();
            var toDay = null, toMonth = null, toYear = new Date().getFullYear();

            // Движок возвращает первое совпадение $Day, $Month, $NumericDate как [0], второе как [1]
            var numDates = $parseTree._NumericDate;
