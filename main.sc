                fromDay   = days[0]   ? (dayWords[days[0].toLowerCase()]   || null) : null;
                fromMonth = months[0] ? parseMonthStr(months[0]) : null;
                toDay     = days[1]   ? (dayWords[days[1].toLowerCase()]   || null) : null;
                toMonth   = months[1] ? parseMonthStr(months[1]) : (fromMonth || null);

                toYear  = $parseTree._Year ? parseInt($parseTree._Year) : toYear;
                fromYear = toYear;
            }

            function fmt(d, m, y) {
                var mm = (m < 10 ? "0" : "") + m;
                return d + "." + mm + "." + y;
            }

            if (fromDay && fromMonth && toDay && toMonth) {
                $reactions.answer("Удаляю записи с " + fmt(fromDay, fromMonth, fromYear) + " по " + fmt(toDay, toMonth, toYear) + ".");
            } else {
