                "двадцатое":20,"двадцатого":20,"двадцатый":20,"20":20,
                "двадцать первое":21,"двадцать первого":21,"двадцать первый":21,"21":21,
                "двадцать второе":22,"двадцать второго":22,"двадцать второй":22,"22":22,
                "двадцать третье":23,"двадцать третьего":23,"двадцать третий":23,"23":23,
                "двадцать четвертое":24,"двадцать четвёртого":24,"двадцать четвертого":24,"двадцать четвертый":24,"24":24,
                "двадцать пятое":25,"двадцать пятого":25,"двадцать пятый":25,"25":25,
                "двадцать шестое":26,"двадцать шестого":26,"двадцать шестой":26,"26":26,
