                // Два цифровых диапазона
                var nd = Array.isArray(numDates) ? numDates : [numDates];
                if (nd[0]) {
                    var p0 = nd[0].split(/[./]/);
                    fromDay = parseInt(p0[0]); fromMonth = parseInt(p0[1]);
                    fromYear = p0[2] ? parseInt(p0[2]) : fromYear;
                }
                if (nd[1]) {
                    var p1 = nd[1].split(/[./]/);
                    toDay = parseInt(p1[0]); toMonth = parseInt(p1[1]);
                    toYear = p1[2] ? parseInt(p1[2]) : toYear;
                }
            } else {
                // Словесные даты — берём массивы $Day и $Month
