        # «Закончились 8 мая» / «Закончились 8 мая 2025»
        q!: (закончились|закончилось|конец|последний день|завершился|завершились) [цикл|критические|месячные|день] $Day $Month [$Year]
        # «8 мая закончились» / «8 мая 2025 конец цикла»
        q!: $Day $Month [$Year] (закончились|закончилось|конец|последний день|конец цикла)
        # «Отметь конец цикла 8 мая»
        q!: (отметь|запиши|внеси|добавь) (конец|последний день|завершение) [цикла|месячных|критических] $Day $Month [$Year]
        # «Конец цикла был 8 мая»
        q!: (конец|закончились|завершение) [цикла|месячных|цикл] (было|был|задним числом) $Day $Month [$Year]
        # «Конец 8.03.2025» / «конец цикла 08/03/2025»
        q!: (закончились|закончилось|конец|последний день|завершился|завершились|отметь|запиши) [цикл|критические|месячные|день|цикла] $NumericDate
        # просто цифровая дата без глагола: «8.03.2025»
        q!: $NumericDate (конец|закончились|последний день|конец цикла)
        script:
            var dayWords = {
                "первое":1,"первого":1,"первый":1,"1":1,
                "второе":2,"второго":2,"второй":2,"2":2,
                "три":3,"третье":3,"третьего":3,"третий":3,"3":3,
                "четвертое":4,"четвертого":4,"четвёртое":4,"четвёртого":4,"четвертый":4,"4":4,
                "пятое":5,"пятого":5,"пятый":5,"5":5,
                "шестое":6,"шестого":6,"шестой":6,"6":6,
                "седьмое":7,"седьмого":7,"седьмой":7,"7":7,
                "восьмое":8,"восьмого":8,"восьмой":8,"8":8,
                "девятое":9,"девятого":9,"девятый":9,"9":9,
                "десятое":10,"десятого":10,"десятый":10,"10":10,
                "одиннадцатое":11,"одиннадцатого":11,"одиннадцатый":11,"11":11,
                "двенадцатое":12,"двенадцатого":12,"двенадцатый":12,"12":12,
                "тринадцатое":13,"тринадцатого":13,"тринадцатый":13,"13":13,
                "четырнадцатое":14,"четырнадцатого":14,"четырнадцатый":14,"14":14,
                "пятнадцатое":15,"пятнадцатого":15,"пятнадцатый":15,"15":15,
                "шестнадцатое":16,"шестнадцатого":16,"шестнадцатый":16,"16":16,
                "семнадцатое":17,"семнадцатого":17,"семнадцатый":17,"17":17,
                "восемнадцатое":18,"восемнадцатого":18,"восемнадцатый":18,"18":18,
                "девятнадцатое":19,"девятнадцатого":19,"девятнадцатый":19,"19":19,
                "двадцатое":20,"двадцатого":20,"двадцатый":20,"20":20,
                "двадцать первое":21,"двадцать первого":21,"двадцать первый":21,"21":21,
                "двадцать второе":22,"двадцать второго":22,"двадцать второй":22,"22":22,
                "двадцать третье":23,"двадцать третьего":23,"двадцать третий":23,"23":23,
                "двадцать четвертое":24,"двадцать четвёртого":24,"двадцать четвертого":24,"двадцать четвертый":24,"24":24,
                "двадцать пятое":25,"двадцать пятого":25,"двадцать пятый":25,"25":25,
                "двадцать шестое":26,"двадцать шестого":26,"двадцать шестой":26,"26":26,
                "двадцать седьмое":27,"двадцать седьмого":27,"двадцать седьмой":27,"27":27,
                "двадцать восьмое":28,"двадцать восьмого":28,"двадцать восьмой":28,"28":28,
                "двадцать девятое":29,"двадцать девятого":29,"двадцать девятый":29,"29":29,
                "тридцатое":30,"тридцатого":30,"тридцатый":30,"30":30,
                "тридцать первое":31,"тридцать первого":31,"тридцать первый":31,"31":31
            };
            var pDay = null, pMonth = null, pYear = new Date().getFullYear();

            // Сначала пробуем цифровую дату: 8.03.2025 или 08/03/2025
            if ($parseTree._NumericDate) {
                var parts = $parseTree._NumericDate.split(/[./]/);
                pDay   = parseInt(parts[0]);
                pMonth = parseInt(parts[1]);
                pYear  = parseInt(parts[2]);
            } else {
                // Иначе разбираем словесный день и месяц
                pDay = $parseTree._Day ? (dayWords[$parseTree._Day.toLowerCase()] || null) : null;
                if ($parseTree._Month) {
                    var ms = $parseTree._Month.toLowerCase();
                    if      (ms.indexOf("январ")   !== -1) pMonth = 1;
                    else if (ms.indexOf("феврал")  !== -1) pMonth = 2;
                    else if (ms.indexOf("март")    !== -1) pMonth = 3;
                    else if (ms.indexOf("апрел")   !== -1) pMonth = 4;
                    else if (ms.indexOf("ма")      !== -1) pMonth = 5;
                    else if (ms.indexOf("июн")     !== -1) pMonth = 6;
                    else if (ms.indexOf("июл")     !== -1) pMonth = 7;
                    else if (ms.indexOf("август")  !== -1) pMonth = 8;
                    else if (ms.indexOf("сентябр") !== -1) pMonth = 9;
                    else if (ms.indexOf("октябр")  !== -1) pMonth = 10;
                    else if (ms.indexOf("ноябр")   !== -1) pMonth = 11;
                    else if (ms.indexOf("декабр")  !== -1) pMonth = 12;
                }
                pYear = $parseTree._Year ? parseInt($parseTree._Year) : new Date().getFullYear();
            }

            if (pDay && pMonth) {
                var monthStr2 = (parseInt(pMonth) < 10 ? "0" : "") + parseInt(pMonth);
                $reactions.answer("Отметил конец цикла: " + pDay + "." + monthStr2 + "." + pYear + ".");
            } else if (pDay) {
                $reactions.answer("Отметил конец цикла: " + pDay + "-го числа.");
            } else {
                $reactions.answer("Отметил конец цикла.");
            }

            $response.replies = $response.replies || [];
            $response.replies.push({
                "type": "raw",
                "body": {
                    "items": [{
                        "command": {
                            "type": "smart_app_data",
                            "smart_app_data": {
                                "type": "END_CYCLE_BACKDATED",
                                "payload": {
                                    "day":   pDay,
                                    "month": pMonth,
                                    "year":  pYear
                                }
                            }
                        }
                    }]
                }
            });

    # ──────────────────────────────────────────────
    #  Начало цикла
    # ──────────────────────────────────────────────
    state: НачалоЦикла
        q!: (начались|началось|начало|старт|первый|день первый|начало цикла|день цикла начался|цикл начался) [цикл|критические|месячные|день]
        script:
            $reactions.answer("Отметил начало цикла, берегите себя!");
            $response.replies = $response.replies || [];
            $response.replies.push({
                "type": "raw",
                "body": {
                    "items": [{
                        "command": {
                            "type": "smart_app_data",
                            "smart_app_data": { "type": "START_CYCLE" }
                        }
                    }]
                }
            });

    # ──────────────────────────────────────────────
    #  Конец цикла
    # ──────────────────────────────────────────────
    state: КонецЦикла
        q!: (закончились|закончилось|конец|завершились|завершился|последний день|конец цикла|цикл закончился) [цикл|критические|месячные|день]
        script:
            $reactions.answer("Отметил конец цикла, как самочувствие?");
            $response.replies = $response.replies || [];
            $response.replies.push({
                "type": "raw",
                "body": {
                    "items": [{
                        "command": {
                            "type": "smart_app_data",
                            "smart_app_data": { "type": "END_CYCLE" }
                        }
                    }]
                }
            });

    # ──────────────────────────────────────────────
    #  Запрос совета: Бот просит фронтенд выдать совет
    # ──────────────────────────────────────────────
    state: ЗапросСовета
        q!: (совет|дай совет|что посоветуешь|посоветуй|что делать|как мне быть|помоги|порекомендуй|рекомендация)
        script:
            $reactions.answer("Смотрю ваш календарь...");
            $response.replies = $response.replies || [];
            $response.replies.push({
                "type": "raw",
                "body": {
                    "items": [{
                        "command": {
                            "type": "smart_app_data",
                            "smart_app_data": { "type": "GET_ADVICE_REQUESTED" }
                        }
                    }]
                }
            });

    # ──────────────────────────────────────────────
    #  Фронт собрал нужный совет и просит бота его озвучить
    # ──────────────────────────────────────────────
    state: ФронтендПрислалСовет
        event!: ADVICE_READY
        script:
            var pParams = {};
            if ($request.data && $request.data.parameters) {
                pParams = $request.data.parameters;
            } else if ($request.rawRequest && $request.rawRequest.payload && $request.rawRequest.payload.serverAction) {
                pParams = $request.rawRequest.payload.serverAction.parameters || {};
            } else if ($request.data && $request.data.action) {
                pParams = $request.data.action.parameters || {};
            }
            
            var textToSpeak = pParams.advice || "Отдыхайте и заботьтесь о себе!";
            $reactions.answer(textToSpeak);

    # ──────────────────────────────────────────────
    #  Если фронт ответил, что цикл еще не начат
    # ──────────────────────────────────────────────
